# MongoDB Connection
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/database
# OR use individual components:
# MONGO_HOST=cluster.mongodb.net
# MONGO_USER=user
# MONGO_PASSWORD=password
# MONGO_DATABASE=database

# xAPI LRS
XAPI_LRS_ENDPOINT=https://lrs.example.com/xapi/statements
XAPI_AUTH_TOKEN=your-auth-token

# GCP / BigQuery Configuration
GCP_PROJECT=your-gcp-project-id
GCP_BQ_DATASET=raw
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# dlt Destination - set to 'bigquery' (or omit - defaults to bigquery)
DLT_DESTINATION=bigquery

# dbt Target - set to 'dev' for BigQuery (instead of 'duckdb')
DBT_TARGET=dev

# Dagster
DAGSTER_HOME=/path/to/.dagster_home
