FROM python:3.11-slim

# Install uv for fast dependency management
RUN pip install --no-cache-dir uv

# Install Dagster packages (webserver and daemon)
RUN uv pip install --system \
    dagster \
    dagster-graphql \
    dagster-webserver \
    dagster-postgres \
    dagster-docker

# Set $DAGSTER_HOME and copy dagster.yaml and workspace.yaml there
ENV DAGSTER_HOME=/opt/dagster/dagster_home/
RUN mkdir -p $DAGSTER_HOME

COPY dagster.yaml workspace.yaml $DAGSTER_HOME
COPY configure_dagster.py dagster_entrypoint.sh $DAGSTER_HOME

WORKDIR $DAGSTER_HOME

# Make scripts executable
RUN chmod +x configure_dagster.py dagster_entrypoint.sh

